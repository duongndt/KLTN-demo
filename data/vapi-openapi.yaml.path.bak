openapi: 3.0.0
info:
  title: vAPI
  version: 1.0.0
  description:
    vAPI is Vulnerable Adversely Programmed Interface which is Self-Hostable
    API Interface that mimics OWASP API Top 10 scenarios in the means of Exercises.
servers:
  - url: http://localhost
paths:
  /vapi/api1/user:
    post:
      summary: Create User
      operationId: Create_User
      parameters: []
      responses:
        "200":
          description: Successful response
        "401":
          description: Unauthorized
        "403":
          description: Forbidden
        "404":
          description: Not found
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
      security:
        - bearerAuth: []
  /vapi/api1/user/{api1_id}:
    get:
      summary: Get User
      operationId: Get_User
      parameters:
        - name: api1_id
          in: path
          required: true
          schema:
            type: string
          description: ID of the user
      responses:
        "200":
          description: Successful response
        "401":
          description: Unauthorized
        "403":
          description: Forbidden
        "404":
          description: Not found
    put:
      summary: Update User
      operationId: Update_User
      parameters:
        - name: api1_id
          in: path
          required: true
          schema:
            type: string
          description: ID of the user
      responses:
        "200":
          description: Successful response
        "401":
          description: Unauthorized
        "403":
          description: Forbidden
        "404":
          description: Not found
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
      security:
        - bearerAuth: []
